# Copy this file to .env and fill in real values:
#   Copy-Item .env.example .env
# .env is git-ignored; .env.example is committed as documentation.

# Secret used to sign JWTs (at least 32 bytes). Generate one with:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# How long a login token stays valid, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend URLs allowed by CORS (comma-separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL connection: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# "localhost" = the Postgres container started with `docker compose up -d db`.
# (When the backend itself runs in Docker, docker-compose.yml overrides this
# with host "db".)
DATABASE_URL=postgresql+psycopg://todo:todo@localhost:5432/todo

# Print every SQL query to the console (true/false)
SQL_ECHO=false
