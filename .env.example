# =============================================================================
# Environment variables for the whole project (Docker Compose + local runs)
#
#   1. Copy this file:      Copy-Item .env.example .env
#   2. Fill in every empty value below (see docs/docker.md for generators)
#
# .env is git-ignored. NEVER put real values in this example file.
# Docker Compose refuses to start if a required value is missing.
# =============================================================================

# ---------- PostgreSQL ----------
# Used to create the database the FIRST time the db container starts.
POSTGRES_USER=todo
POSTGRES_DB=todo
POSTGRES_PASSWORD=

# ---------- Backend (FastAPI) ----------
# Signs JWTs. At least 32 random bytes (64 hex characters).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Frontend URLs allowed by CORS (comma-separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true = print every SQL query SQLAlchemy runs
SQL_ECHO=false

# ---------- Frontend (React / Vite) ----------
# Only VITE_* variables reach the browser. Never put secrets in them.
VITE_API_URL=http://localhost:8000/api

# ---------- pgAdmin (database UI at http://localhost:5050) ----------
# The login for the pgAdmin web page. Must look like an email address.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=
