    {
      "name": "3. Security (authorization)",
      "item": [
        {
          "name": "No token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('WWW-Authenticate: Bearer header', () => {",
                  "    pm.expect(pm.response.headers.get('WWW-Authenticate')).to.eql('Bearer');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/todos"
          }
        },
        {
          "name": "Garbage token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Message', () => pm.expect(pm.response.json().detail).to.eql('Invalid or expired token'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "this.is.not-a-real-jwt", "type": "string" }]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/todos"
          }
        },
        {
          "name": "Tampered token (401)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Take our real token and change one character of the signature.",
                  "// The payload is untouched, but the server must reject it.",
                  "const [header, payload, sig] = pm.collectionVariables.get('access_token').split('.');",
                  "const badSig = (sig[0] === 'A' ? 'B' : 'A') + sig.slice(1);",
                  "pm.collectionVariables.set('tampered_token', [header, payload, badSig].join('.'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 (signature check failed)', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tampered_token}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/todos"
          }
        },
        {
          "name": "Register second user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('username_2', 'other_' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username_2}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login second user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('access_token_2', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username_2}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Second user sees an empty list",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('First user\\'s todos are not visible', () => {",
                  "    pm.expect(pm.response.json()).to.be.an('array').that.is.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token_2}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/todos"
          }
        },
        {
          "name": "Second user reads first user's todo (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 404 instead of 403: don't even reveal that the todo exists",
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token_2}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/todos/{{todo_id_2}}"
          }
        },
        {
          "name": "Second user deletes first user's todo (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token_2}}", "type": "string" }]
            },
            "method": "DELETE",
            "url": "{{baseUrl}}/api/todos/{{todo_id_2}}"
          }
        },
        {
          "name": "First user's todo still exists",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 - the delete above did nothing', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/todos/{{todo_id_2}}"
          }
        }
      ]
    },
    {
      "name": "4. CORS",
      "description": "Browsers send an OPTIONS 'preflight' before cross-origin requests that carry JSON or an Authorization header. Postman is not a browser, so it never blocks anything itself; these requests imitate what the browser sends and check what the server answers.",
      "item": [
        {
          "name": "Preflight from allowed origin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Origin is allowed', () => {",
                  "    pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql('http://localhost:5173');",
                  "});",
                  "pm.test('Authorization header is allowed', () => {",
                  "    pm.expect(pm.response.headers.get('Access-Control-Allow-Headers').toLowerCase()).to.include('authorization');",
                  "});",
                  "pm.test('PATCH is an allowed method', () => {",
                  "    pm.expect(pm.response.headers.get('Access-Control-Allow-Methods')).to.include('PATCH');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "OPTIONS",
            "header": [
              { "key": "Origin", "value": "http://localhost:5173" },
              { "key": "Access-Control-Request-Method", "value": "POST" },
              { "key": "Access-Control-Request-Headers", "value": "authorization,content-type" }
            ],
            "url": "{{baseUrl}}/api/todos"
          }
        },
        {
          "name": "Preflight from blocked origin (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('No Access-Control-Allow-Origin, so a browser would block it', () => {",
                  "    pm.response.to.not.have.header('Access-Control-Allow-Origin');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "OPTIONS",
            "header": [
              { "key": "Origin", "value": "http://evil.example.com" },
              { "key": "Access-Control-Request-Method", "value": "POST" }
            ],
            "url": "{{baseUrl}}/api/todos"
          }
        },
        {
          "name": "Real request exposes custom headers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Allow-Origin echoes our origin', () => {",
                  "    pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql('http://localhost:5173');",
                  "});",
                  "pm.test('expose_headers lets JS read X-Request-ID and X-Process-Time', () => {",
                  "    const exposed = pm.response.headers.get('Access-Control-Expose-Headers');",
                  "    pm.expect(exposed).to.include('X-Request-ID');",
                  "    pm.expect(exposed).to.include('X-Process-Time');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Origin", "value": "http://localhost:5173" }],
            "url": "{{baseUrl}}/api/todos"
          }
        }
      ]
    },
    {
      "name": "5. Logout (token revocation)",
      "description": "Runs last because it revokes access_token. The JWT itself is still correctly signed and not expired - it is rejected only because its row in the tokens table now has revoked_at set.",
      "item": [
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/logout"
          }
        },
        {
          "name": "Me with revoked token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Rejected because it was revoked', () => {",
                  "    pm.expect(pm.response.json().detail).to.eql('Token has been revoked');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Other user's token still works",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Revocation is per token: logging out one session doesn't affect others",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Still the second user', () => {",
                  "    pm.expect(pm.response.json().username).to.eql(pm.collectionVariables.get('username_2'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token_2}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    }
  ]
}
