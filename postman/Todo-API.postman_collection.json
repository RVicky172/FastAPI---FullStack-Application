    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// New username every run, so re-running never hits 'already taken'",
                  "pm.collectionVariables.set('username', 'user_' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Returns the new user', () => {",
                  "    pm.expect(body.id).to.be.a('string');",
                  "    pm.expect(body.username).to.eql(pm.collectionVariables.get('username'));",
                  "});",
                  "pm.test('response_model hides hashed_password', () => {",
                  "    pm.expect(body).to.not.have.property('hashed_password');",
                  "});",
                  "pm.collectionVariables.set('user_id', body.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Creates a user. Pydantic checks: username 3-30 chars (letters, digits, _) and password at least 6 chars."
          }
        },
        {
          "name": "Register - duplicate username (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('Explains why', () => {",
                  "    pm.expect(pm.response.json().detail).to.eql('Username already taken');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Register - invalid data (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Pydantic rejects the body before our route code runs",
                  "const detail = pm.response.json().detail;",
                  "pm.test('Status 422 Unprocessable', () => pm.response.to.have.status(422));",
                  "pm.test('One error per invalid field', () => {",
                  "    const fields = detail.map(e => e.loc[e.loc.length - 1]);",
                  "    pm.expect(fields).to.include.members(['username', 'password']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ab\",\n  \"password\": \"1\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login - wrong password (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Generic message (does not reveal whether the user exists)', () => {",
                  "    pm.expect(pm.response.json().detail).to.eql('Incorrect username or password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login (saves token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns a bearer token', () => {",
                  "    pm.expect(body.token_type).to.eql('bearer');",
                  "    pm.expect(body.access_token.split('.')).to.have.lengthOf(3); // header.payload.signature",
                  "});",
                  "",
                  "// Decode the JWT payload (middle part, base64url) to see what's inside.",
                  "// Anyone can READ a JWT - the signature only stops them CHANGING it.",
                  "const b64 = body.access_token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "const payload = JSON.parse(atob(b64 + '='.repeat((4 - b64.length % 4) % 4)));",
                  "console.log('JWT payload:', payload);",
                  "pm.test('Token subject (sub) is our user id', () => {",
                  "    pm.expect(payload.sub).to.eql(pm.collectionVariables.get('user_id'));",
                  "});",
                  "pm.test('Token has an expiry (exp)', () => {",
                  "    pm.expect(payload.exp).to.be.above(Date.now() / 1000);",
                  "});",
                  "pm.test('Token has a unique id (jti) - its row in the tokens table', () => {",
                  "    pm.expect(payload.jti).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "// Every later request uses Bearer {{access_token}} (collection auth)",
                  "pm.collectionVariables.set('access_token', body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Me (current user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Token belongs to our user', () => {",
                  "    pm.expect(pm.response.json().username).to.eql(pm.collectionVariables.get('username'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me",
            "description": "No auth set here, so it inherits Bearer {{access_token}} from the collection."
          }
        },
        {
          "name": "Sessions (tokens stored in DB)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sessions = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('One active login, marked as current', () => {",
                  "    pm.expect(sessions).to.have.lengthOf(1);",
                  "    pm.expect(sessions[0].current).to.be.true;",
                  "});",
                  "pm.test('Raw token is NOT stored or returned', () => {",
                  "    pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get('access_token'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/sessions",
            "description": "Lists rows from the tokens table for the current user: one per login."
          }
        }
      ]
    },
